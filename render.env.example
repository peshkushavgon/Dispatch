# Core dispatcher — required
TELEGRAM_BOT_TOKEN=<current dispatcher Telegram bot token>
OPENAI_API_KEY=<OpenAI API key>
MAPBOX_TOKEN=<Mapbox public access token>

# Triumph MC checks
TRIUMPH_CLIENT_ID=126906
TRIUMPH_REFRESH_TOKEN=<current Triumph refresh token>
# Optional initial access token; automatic renewal uses the refresh token above.
TRIUMPH_TOKEN=<optional current Triumph access token>
# Required on Render Free so Okta's rotated refresh token survives restarts.
UPSTASH_REDIS_REST_URL=<Upstash Redis REST URL>
UPSTASH_REDIS_REST_TOKEN=<Upstash Redis REST token>
# A strong random secret used to encrypt Triumph tokens before remote storage.
TRIUMPH_TOKEN_ENCRYPTION_KEY=<at least 32 random characters>

# MC brokerage contact lookup
# Free official FMCSA developer key used for the registered phone number.
FMCSA_WEB_KEY=<FMCSA QCMobile API web key>
# Email/domain lookup uses the existing OPENAI_API_KEY and caches results for 24 hours.
BROKER_CONTACT_WEB_SEARCH=true
BROKER_CONTACT_MODEL=gpt-5.4-mini

# Rais Gmail automation
RAIS_ENABLED=true
RAIS_ALLOWED_CHAT_IDS=<comma-separated Telegram chat IDs>
# Optional but recommended. Empty allows every user inside the allowed chats.
RAIS_ALLOWED_USERNAMES=<comma-separated Telegram usernames without @>
GMAIL_CLIENT_ID=<copy from the old Rais environment>
GMAIL_CLIENT_SECRET=<copy from the old Rais environment>
GMAIL_REDIRECT_URI=<copy from the old Rais environment>
GMAIL_REFRESH_TOKEN=<copy from the old Rais environment>
# Optional fallback when a Gmail thread has no usable recipient.
DEFAULT_EMAIL_TO=<fallback email address>

# Whole-bot dashboard — required for /dashboard/
BOT_DASHBOARD_PASSWORD=<new strong unique password>

NODE_ENV=production
